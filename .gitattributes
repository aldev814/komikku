* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary

# Preserve vendored iReader dependency bytes.
/third-party/ireader-legacy/**/*.aar binary
/third-party/ireader-legacy/**/*.patch -whitespace
/third-party/ireader-legacy/flexible-adapter/LICENSE -whitespace
