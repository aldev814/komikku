* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary

# iReader patch payloads and vendored Android archive
*.patch -whitespace
*.aar binary
# Preserve the upstream license file verbatim.
/.github/ireader/legacy/flexible-adapter/LICENSE -whitespace
