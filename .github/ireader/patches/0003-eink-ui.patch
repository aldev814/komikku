+fun ElevatedCard(
+    modifier: Modifier = Modifier,
+    shape: Shape = CardDefaults.elevatedShape,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    if (LocalEInkMode.current) {
+        Card(
